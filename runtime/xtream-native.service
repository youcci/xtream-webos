[Unit]
Description=Xtream native TV catalogue, playback and background refresh
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/lib/xtream-native
ExecStart=/bin/sh /var/lib/xtream-native/start-node.sh /var/lib/xtream-native/server.js
Restart=always
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=journal
LimitCORE=0
