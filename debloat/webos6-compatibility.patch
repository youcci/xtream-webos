-APPS_DIR=/var/preferences/com.webos.applicationManager/blockedSystemAppList
+# Local compatibility for OLED55G19LA, webOS 6.5.3 (03.53.45).
+# This firmware uses blockedAppList / blocked_applist.
+# Its luna-send exits on stdin EOF; keep stdin open for SSH and boot hooks.
+luna_send() { /usr/bin/luna-send "$@" < /dev/zero; }
+
+APPS_DIR=/var/preferences/com.webos.applicationManager/blockedAppList
 BACKUP_DIR=/var/lib/webos-debloat
 HOOK=/var/lib/webosbrew/init.d/50-debloat
 STATE=$BACKUP_DIR/state
