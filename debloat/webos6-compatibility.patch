 #      later bad run cannot quietly destroy the audit trail.
 #
 # WHAT IT CHANGES
-#   Hiding: /var/preferences/com.webos.applicationManager/blockedSystemAppList/<REGION>.json
-#   contains  {"blocked_system_applist":["com.webos.app.x", ...]}
+#   Hiding: /var/preferences/com.webos.applicationManager/blockedAppList/<REGION>.json
+#   contains  {"blocked_applist":["com.webos.app.x", ...]}
 #   Any app ID in that array is hidden from the launcher. The binaries stay
 #   on disk and launch normally if something else calls them. Removing the
 #   ID from the array brings the tile back. This is LG's own regional app
@@ -71,7 +71,12 @@
 # shellcheck disable=SC2086
